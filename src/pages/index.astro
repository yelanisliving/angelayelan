---
import BaseLayout from '../layouts/BaseLayout.astro';

const destinations = [
  {
    href: '/passion-projects',
    label: 'Projects',
    image: '/images/home-nav/projects.png',
    alt: 'A soft watercolor laptop',
  },
  {
    href: '/exhibit',
    label: 'Exhibit',
    image: '/images/home-nav/exhibit.png',
    alt: 'A soft watercolor film clapperboard',
  },
  {
    href: '/involvements',
    label: 'affinity',
    image: '/images/home-nav/life.png',
    alt: 'A soft watercolor bouquet of flowers',
  },
  {
    href: '/about',
    label: 'About',
    image: '/images/home-nav/about.png',
    alt: 'A soft watercolor light bulb',
  },
];
---

<BaseLayout
  title="Angela Yelan"
  description="Angela Yelan is a student who loves stories and is always trying to live life to the fullest."
  hideHeader
  hideFooter={false}
>
  <section class="portfolio-intro" aria-labelledby="home-title">

    <div class="portfolio-intro__hero">
      <div class="portfolio-intro__copy">
        <h1 id="home-title">hi, i'm angela!</h1>
        <p class="portfolio-intro__lede">
          a storyphile and soul bound to the human experience
        </p>

        <nav class="portfolio-intro__destinations" aria-label="Explore Angela's portfolio">
          {
            destinations.map(({ href, label, image, alt }, index) => (
              <a
                class="portfolio-destination"
                href={href}
                style={`--destination-index: ${index}; --destination-tilt: ${index % 2 === 0 ? '-1.5deg' : '1.5deg'};`}
              >
                <span class="portfolio-destination__art">
                  <img src={image} alt={alt} />
                </span>
                <span class="portfolio-destination__label">{label}</span>
              </a>
            ))
          }
        </nav>
      </div>

      <figure class="portfolio-intro__painting">
        <img
          src="/images/crosswalk-haze-wide-v2.png"
          alt="A hazy watercolor view of people moving through a city crosswalk"
        />
      </figure>
    </div>
  </section>
</BaseLayout>
