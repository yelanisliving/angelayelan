---
const pathname = Astro.url.pathname;

const links = [
  { href: '/passion-projects', label: 'projects' },
  { href: '/exhibit', label: 'exhibit' },
  { href: '/involvements', label: 'affinity' },
  { href: '/about', label: 'about' },
];
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    {
      links.map(({ href, label }, index) => (
        <>
          <a
            href={href}
            aria-current={
              pathname === href ||
              (href === '/passion-projects' && pathname.startsWith('/passion-projects')) ||
              (href === '/exhibit' && ['/films', '/image-stills', '/writing'].includes(pathname))
                ? 'page'
                : undefined
            }
          >
            {label}
          </a>
          {index < links.length - 1 && (
            <span class="site-nav__separator" aria-hidden="true">·</span>
          )}
        </>
      ))
    }
  </nav>
</header>
