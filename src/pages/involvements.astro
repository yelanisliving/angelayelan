---

<BaseLayout
  title="Involvements & Activities"
  description="A floating archive of the communities and activities that shape Angela Yelan."
>
  <article class="involvements-page" aria-labelledby="involvements-title">
    <header class="involvements-page__header">
      <p class="eyebrow">Beyond projects</p>
      <h1 id="involvements-title">Involvements &amp; Activities</h1>
      <p>click on the floating words!</p>
    </header>

    <section class="floating-word-bank" aria-label="Involvements and activities word bank">
      {
        involvements.map((item) => (
          <div
            class="floating-word"
            style={`--word-x: ${item.x}; --word-y: ${item.y}; --word-delay: ${item.delay}; --word-glow: ${item.glow};`}
          >
            <button
              type="button"
              data-involvement-trigger
              data-title={item.word}
              data-eyebrow={item.eyebrow}
              data-description={item.description}
              data-image={item.image}
              data-image-position={item.imagePosition}
              data-image-alt={item.imageAlt}
              aria-label={`Open ${item.word}`}
            >
              {item.word}
            </button>
          </div>
        ))
      }
    </section>
  </article>

  <dialog class="involvement-dialog" aria-labelledby="involvement-dialog-eyebrow">
    <div class="involvement-dialog__panel">
      <figure class="involvement-dialog__photo">
        <img data-fallback-src={involvementPhotos.src} alt="" />
      </figure>

      <div class="involvement-dialog__copy">
        <button class="involvement-dialog__close" type="button" aria-label="Close involvement story">
          Close
        </button>
        <p id="involvement-dialog-eyebrow" class="eyebrow" data-dialog-eyebrow></p>
        <p data-dialog-description></p>
      </div>
    </div>
  </dialog>
</BaseLayout>

<script>
  const involvementDialog = document.querySelector<HTMLDialogElement>('.involvement-dialog');
  const dialogPhoto = document.querySelector<HTMLElement>('.involvement-dialog__photo');
  const dialogImage = document.querySelector<HTMLImageElement>('.involvement-dialog__photo img');
  const dialogEyebrow = document.querySelector<HTMLElement>('[data-dialog-eyebrow]');
  const dialogDescription = document.querySelector<HTMLElement>('[data-dialog-description]');
  const dialogClose = document.querySelector<HTMLButtonElement>('.involvement-dialog__close');
  const customCursor = document.querySelector<HTMLElement>('.cursor');
  const involvementTriggers = document.querySelectorAll<HTMLButtonElement>('[data-involvement-trigger]');
  let lastTrigger: HTMLButtonElement | null = null;

  if (
    involvementDialog &&
    dialogPhoto &&
    dialogImage &&
    dialogEyebrow &&
    dialogDescription &&
    dialogClose
  ) {
    involvementTriggers.forEach((trigger) => {
      const imageSource = trigger.dataset.image;
      if (imageSource) {
        const preloadedImage = new Image();
        preloadedImage.src = imageSource;
      }
    });

    const revealDialogImage = () => {
      dialogPhoto.classList.remove('is-loading');
      dialogPhoto.setAttribute('aria-busy', 'false');
    };

    involvementTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        lastTrigger = trigger;
        dialogEyebrow.textContent = trigger.dataset.eyebrow ?? '';
        dialogDescription.textContent = trigger.dataset.description ?? '';
        const imageSource = trigger.dataset.image;
        const hasImage = Boolean(imageSource);

        dialogPhoto.hidden = !hasImage;
        involvementDialog.classList.toggle('involvement-dialog--text-only', !hasImage);

        if (hasImage && imageSource) {
          dialogPhoto.classList.add('is-loading');
          dialogPhoto.setAttribute('aria-busy', 'true');
          dialogImage.alt = trigger.dataset.imageAlt ?? '';
          dialogImage.style.objectPosition = trigger.dataset.imagePosition ?? 'center';
          dialogImage.classList.remove('is-fallback');
          dialogImage.onload = revealDialogImage;
          dialogImage.onerror = () => {
            dialogImage.classList.add('is-fallback');
            dialogImage.onerror = null;
            dialogImage.onload = revealDialogImage;
            dialogImage.src = dialogImage.dataset.fallbackSrc ?? '';
          };
          dialogImage.src = imageSource;
          if (dialogImage.complete && dialogImage.naturalWidth > 0) revealDialogImage();
        } else {
          dialogPhoto.classList.remove('is-loading');
          dialogPhoto.setAttribute('aria-busy', 'false');
          dialogImage.alt = '';
          dialogImage.onload = null;
          dialogImage.onerror = null;
          dialogImage.removeAttribute('src');
        }
        involvementDialog.showModal();
        if (customCursor) involvementDialog.append(customCursor);
      });
    });

    dialogClose.addEventListener('click', () => involvementDialog.close());

    involvementDialog.addEventListener('click', (event) => {
      if (event.target === involvementDialog) involvementDialog.close();
    });

    involvementDialog.addEventListener('close', () => {
      if (customCursor) document.body.prepend(customCursor);
      lastTrigger?.focus();
    });
  }
</script>
