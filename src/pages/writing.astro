---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Listed by the optional `order` field (1 = first); otherwise newest first.
const essays = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) =>
    (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const formatDate = (date: Date) =>
  date
    .toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    .toLowerCase();
---

<BaseLayout
  title="Writing"
  description="Essays and creative writing by Angela Yelan."
>
  <section class="cinema-page" aria-labelledby="writing-page-title">
    <header class="cinema-page__masthead">
      <a class="cinema-page__back" href="/exhibit">
        <span aria-hidden="true">←</span> back
      </a>
      <h1 id="writing-page-title">writing</h1>
    </header>

    <ul class="writing-list">
      {
        essays.map((essay) => (
          <li>
            <span class="writing-list__mark" aria-hidden="true">~</span>
            <a href={`/writing/${essay.id.replace(/\.md$/, '')}`}>
              {essay.data.title}{' '}
              <em>({formatDate(essay.data.publishedAt)})</em>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
