---
import { execFileSync } from 'node:child_process';

const linkedInUrl = 'https://www.linkedin.com/in/angela-ye-bb12281ab/';

let lastUpdated = 'recently';

try {
  const committedAt = execFileSync('git', ['log', '-1', '--format=%cI'], {
    encoding: 'utf8',
  }).trim();

  const date = new Date(committedAt);
  const monthAbbr = new Intl.DateTimeFormat('en-US', { month: 'short' }).format(date);
  lastUpdated = `${monthAbbr}. ${date.getDate()} ${date.getFullYear()}`;
} catch {
  // Keep a human-readable fallback when Git metadata is unavailable during a build.
}

const contactLinks = [
  {
    href: 'https://github.com/yelanisliving',
    label: 'Angela Ye on GitHub',
    image: '/images/contact/github-watercolor.png',
    external: true,
  },
  {
    href: 'https://www.instagram.com/angelayelan/',
    label: 'Instagram — @angelayelan',
    image: '/images/contact/instagram-watercolor.png',
    external: true,
  },
  {
    href: undefined,
    label: 'Phone number to be added',
    image: '/images/contact/phone-watercolor.png',
    external: false,
  },
  {
    href: linkedInUrl,
    label: 'Angela Ye on LinkedIn',
    image: '/images/contact/linkedin-watercolor.png',
    external: true,
  },
  {
    href: 'mailto:angelaye@berkeley.edu',
    label: 'Email angelaye@berkeley.edu',
    image: '/images/contact/email-watercolor.png',
    external: false,
  },
];
---

<footer class="site-footer">
  <p class="site-footer__updated">
    last updated {lastUpdated.toLowerCase()}.
    {' '}
    <span data-visitor-count></span>
  </p>
  <p class="site-footer__discipline">media tech / visual computing</p>
  <nav class="site-footer__contacts" aria-label="Contact Angela">
    {
      contactLinks.map(({ href, label, image, external }) =>
        href ? (
          <a
            href={href}
            aria-label={label}
            title={label}
            target={external ? '_blank' : undefined}
            rel={external ? 'noreferrer' : undefined}
          >
            <img src={image} alt="" />
          </a>
        ) : (
          <span class="site-footer__contact--pending" aria-label={label} title={label}>
            <img src={image} alt="" />
          </span>
        ),
      )
    }
  </nav>
</footer>

<script>
  const ordinal = (count: number) => {
    const remainder100 = count % 100;
    if (remainder100 >= 11 && remainder100 <= 13) return `${count}th`;
    switch (count % 10) {
      case 1:
        return `${count}st`;
      case 2:
        return `${count}nd`;
      case 3:
        return `${count}rd`;
      default:
        return `${count}th`;
    }
  };

  const visitorCountEl = document.querySelector('[data-visitor-count]');

  if (visitorCountEl) {
    // sessionStorage = "already counted in this tab" (cleared when the tab closes).
    // localStorage = last known total, shown instantly in a new tab before the fresh count arrives.
    const SESSION_KEY = 'angelayelan-visit-count-session';
    const LAST_KEY = 'angelayelan-visit-count-last';

    const read = (storage: () => Storage, key: string) => {
      try {
        const value = Number(storage().getItem(key));
        return Number.isFinite(value) && value > 0 ? value : null;
      } catch {
        // Private browsing or blocked storage.
        return null;
      }
    };

    const write = (storage: () => Storage, key: string, value: number) => {
      try {
        storage().setItem(key, String(value));
      } catch {
        // Ignore storage failures — the count still displays correctly this load.
      }
    };

    const show = (count: number) => {
      visitorCountEl.textContent = `you're the ${ordinal(count)} visitor :)`;
    };

    const sessionCount = read(() => sessionStorage, SESSION_KEY);
    const lastCount = read(() => localStorage, LAST_KEY);

    if (sessionCount) {
      // Already counted in this tab — page changes and refreshes don't add visits.
      show(sessionCount);
    } else {
      // New tab: show the last known total right away, then count this visit.
      if (lastCount) show(lastCount);

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 8000);

      fetch('/api/visit', { signal: controller.signal })
        .then((response) => (response.ok ? response.json() : Promise.reject(new Error('counter error'))))
        .then((data) => {
          if (!Number.isFinite(data?.value)) return;
          show(data.value);
          write(() => sessionStorage, SESSION_KEY, data.value);
          write(() => localStorage, LAST_KEY, data.value);
        })
        .catch(() => {
          // Keep whatever is already showing if the counter is unreachable.
        })
        .finally(() => {
          window.clearTimeout(timeout);
          // Only fall back to generic text if no count could be shown at all.
          if (!visitorCountEl.textContent) visitorCountEl.textContent = "you're a visitor :)";
        });
    }
  }
</script>
