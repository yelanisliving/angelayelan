---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import sortingHatCover from '../../photography/one.png';
import colorGradingCover from '../../photography/two.png';
import birdieCover from '../../photography/three.png';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const getProjectSlug = (id: string) => id.replace(/\.md$/, '');
const projectImageOverrides: Record<string, { src: string; alt: string }> = {
  'technical-project-01': {
    src: sortingHatCover.src,
    alt: 'Handmade voice-interactive Hogwarts Sorting Hat on a dark background',
  },
  'technical-project-02': {
    src: colorGradingCover.src,
    alt: 'Poster for the cinematic color-grading research project',
  },
  'technical-project-03': {
    src: birdieCover.src,
    alt: 'BIRDIE badminton form-analysis logo',
  },
};
---

<BaseLayout
  title="Projects"
  description="Technical projects and experiments by Angela Yelan."
>
  <section class="projects-index" aria-labelledby="projects-title">
    <header class="projects-index__intro">
      <h1 id="projects-title">projects</h1>
      <p>
        build build and build
      </p>
    </header>

    <div class="projects-index__grid">
      {
        projects.map((project, index) => {
          const slug = getProjectSlug(project.id);
          const image = projectImageOverrides[slug];

          return (
            <a class="project-tile" href={`/passion-projects/${slug}`}>
              <div class="project-tile__media">
                {image || project.data.image ? (
                  <img
                    src={image?.src ?? project.data.image}
                    alt={image?.alt ?? project.data.imageAlt ?? ''}
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <span>Project image</span>
                )}
              </div>
              <div class="project-tile__content">
                <div class="project-tile__title-row">
                  <h2>{project.data.title}</h2>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
