---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = 'Angela Yelan',
  description = 'The personal portfolio and notebook of Angela Yelan.',
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

const pageTitle = title === 'Angela Yelan' ? title : `${title} — Angela Yelan`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=ZCOOL+XiaoWei&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.png" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Cursor />
      <div class="site-shell">
        {!hideHeader && <Header />}

        <a class="site-brand" href="/">
          angelayelan<br />portfolio
        </a>

        <main>
          <slot />
        </main>

        {!hideFooter && <Footer />}
      </div>
  </body>
</html>
