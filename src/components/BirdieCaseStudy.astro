---
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: CollectionEntry<'projects'>['data'];
}

const { data } = Astro.props;

const sections = [
  { id: 'overview', label: 'overview' },
  { id: 'research', label: 'research' },
  { id: 'build', label: 'build' },
  { id: 'testing', label: 'testing' },
  { id: 'outcome', label: 'outcome' },
];

// "View our labeling here." in the dataset note links here once a URL is added.
const labelingUrl =
  'https://docs.google.com/spreadsheets/d/1kunlqvag6vXkwClyrXMOl8vKZKrqTVIrXMRTmVU4lzw/edit?usp=sharing';

const base = '/projects/birdie';
const datasetPhotos = [
  {
    src: `${base}/build-photo-good.webp`,
    alt: 'Player with the racket held behind the head and the other arm raised, labeled good.',
    caption: 'Good',
  },
  {
    src: `${base}/build-photo-low-arm.webp`,
    alt: 'Player with one hand raised high and the racket held low in front of the body.',
    caption: 'Right arm too low, racket arm not opened, right elbow angle, left arm too high',
  },
  {
    src: `${base}/build-photo-left-elbow.webp`,
    alt: 'Player with one palm raised near the chest and the racket held beside the head.',
    caption: 'Right arm too low, racket arm not opened, right elbow angle, left elbow angle',
  },
  {
    src: `${base}/build-photo-not-opened.webp`,
    alt: 'Player holding the racket straight up with the other arm stretched out to the side.',
    caption: 'Racket arm not opened',
  },
];
---

<article class="birdie-study" data-birdie-study>
  <div class="birdie-study__bar">
    <a class="birdie-study__back" href="/passion-projects">
      <span aria-hidden="true">←</span> back
    </a>
    <nav class="birdie-study__tabs" role="tablist" aria-label="BIRDIE case study sections">
      {
        sections.map((section, index) => (
          <>
            <button
              class="birdie-study__tab"
              type="button"
              role="tab"
              id={`birdie-tab-${section.id}`}
              aria-controls={`birdie-panel-${section.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-tab={section.id}
            >
              {section.label}
            </button>
            {index < sections.length - 1 && (
              <span class="birdie-study__tab-separator" aria-hidden="true">·</span>
            )}
          </>
        ))
      }
    </nav>
  </div>

  <h1>{data.title}</h1>

  <div class="birdie-study__panels">
    <section
      class="birdie-study__panel birdie-study__panel--overview"
      id="birdie-panel-overview"
      role="tabpanel"
      aria-labelledby="birdie-tab-overview"
      data-panel="overview"
    >
      <div class="birdie-study__overview-copy">
        <h2>Form analysis designed for beginners!</h2>
        <p>
          BIRDIE is a mobile coaching tool that uses computer vision and machine learning to help
          beginner badminton players understand and improve their form.
        </p>
        <p>
          Built with my badminton teammate, the system detects body landmarks in real time and
          measures important arm and elbow positions.
        </p>
        <p>
          We created and labeled our own badminton-form dataset, experimented with angle-based
          evaluation and image classification, and integrated the system into a React Native mobile
          experience.
        </p>
        <p class="birdie-study__tags">
          computer vision | machine learning | dataset creation | mobile integration | UI design
        </p>
      </div>
      {
        data.appScreenUrl && (
          <figure class="birdie-study__screen">
            <img src={data.appScreenUrl} alt="BIRDIE badminton form-analysis app home screen" />
          </figure>
        )
      }
    </section>

    <section
      class="birdie-study__panel birdie-study__panel--research birdie-study__panel--scroll"
      id="birdie-panel-research"
      role="tabpanel"
      aria-labelledby="birdie-tab-research"
      data-panel="research"
      hidden
    >
      <p class="birdie-study__research-lede">
        While coaches can identify mistakes in person, we explored whether computer vision could
        make form feedback more accessible during independent practices.
      </p>
      <p class="birdie-study__research-wide">
        We began researching existing applications of CV in badminton, from shot refinement
        algorithms to shuttlecock tracking / trajectory prediction.
      </p>

      <div class="birdie-study__figures">
        <figure class="birdie-study__figure">
          <img
            src="/projects/birdie/research-pipeline.webp"
            alt="Diagram of a shuttlecock trajectory prediction pipeline: past video frames pass through TrackNet, Faster R-CNN and HRNet, then an LSTM predicts future frames."
            loading="lazy"
          />
          <figcaption>
            Shuttlecock trajectory prediction pipeline.<br />
            Source: Nokihara et al. (2023),
            <a href="https://www.mdpi.com/2313-433X/9/5/99" target="_blank" rel="noreferrer">
              Future Prediction of Shuttlecock Trajectory in Badminton Using Player’s Information
            </a>
          </figcaption>
        </figure>

        <figure class="birdie-study__figure">
          <img
            src="/projects/birdie/research-mediapipe.webp"
            alt="MediaPipe Pose landmarks for the shoulders, arms and hips, shown as numbered points joined by green and blue lines."
            loading="lazy"
          />
          <figcaption>
            MediaPipe Pose landmark connections.<br />
            Based on
            <a
              href="https://ai.google.dev/edge/mediapipe/solutions/vision/pose_landmarker"
              target="_blank"
              rel="noreferrer"
            >
              Google Mediapipe Pose documentation
            </a>
          </figcaption>
        </figure>
      </div>

      <figure class="birdie-study__figure birdie-study__figure--side">
        <figcaption>
          Annotated trajectories during a badminton rally for shot refinement training.<br />
          Source: Hsu et al. (2024),
          <a href="https://www.mdpi.com/1424-8220/24/13/4372" target="_blank" rel="noreferrer">
            Sensors, 24(13), Article 4372
          </a>
        </figcaption>
        <img
          src="/projects/birdie/research-trajectories.webp"
          alt="Badminton rally on a court with colored lines tracing the paths of several shuttlecock trajectories."
          loading="lazy"
        />
      </figure>

      <p class="birdie-study__research-wide">
        We narrowed our focus to real-time pose estimation with a live camera, as many of the
        projects in the papers we read all relied on immense amounts of video data and training.
      </p>
    </section>

    <section
      class="birdie-study__panel birdie-study__panel--build birdie-study__panel--scroll"
      id="birdie-panel-build"
      role="tabpanel"
      aria-labelledby="birdie-tab-build"
      data-panel="build"
      hidden
    >
      <div class="birdie-study__step">
        <h2>1. Dataset Creation</h2>
        <p class="birdie-study__step-copy">
          We built our own dataset of 290+ images, capturing players demonstrating different
          racket-arm positions.<br />
          We manually labeled each image according to its form, focusing on arm placement, elbow
          angle, and whether an arm is “open.”
        </p>
        <p class="birdie-study__step-note">
          The image dataset is not public, since it contains pictures of people’s forms other than
          ours.
          {
            labelingUrl ? (
              <a href={labelingUrl} target="_blank" rel="noreferrer">View our labeling here.</a>
            ) : (
              <>View our labeling here.</>
            )
          }
        </p>

        <div class="birdie-study__photos">
          {
            datasetPhotos.map((photo) => (
              <figure>
                <img src={photo.src} alt={photo.alt} loading="lazy" />
                <figcaption>{photo.caption}</figcaption>
              </figure>
            ))
          }
        </div>

        <div class="birdie-study__labeling">
          <p class="birdie-study__labeling-copy">
            We used multi-label one hot encoding when making our CSV file.<br />
            Also, after asking checking with our coaches regarding what a “correct” form looks like,
            we realized that some rules can be hardcoded, like the left elbow angle.
          </p>
          <figure>
            <img
              class="birdie-study__labels-img"
              src={`${base}/build-labels.webp`}
              alt="List of labels: good, right elbow too low (angle d), right arm not opened, left arm not opened, right elbow angle (angle c), left elbow too low (angle b) and left elbow angle (angle a), each with the method used to detect it."
              loading="lazy"
            />
            <figcaption>Labels + corresponding angels</figcaption>
          </figure>
          <figure>
            <img
              class="birdie-study__annotated-img"
              src={`${base}/build-annotated-angles.webp`}
              alt="Stick-figure drawing of the shoulders and arms on a black background with the elbow and arm angles a, b, c and d marked in green."
              loading="lazy"
            />
            <figcaption>Annotated elbow &amp; arm angles</figcaption>
          </figure>
        </div>
      </div>

      <div class="birdie-study__step">
        <h2>2. Pose Estimation &amp; Feature Extraction</h2>
        <p class="birdie-study__step-copy">
          Using MediaPipe Pose and OpenCV, we extracted body landmarks from each image.<br />
          To account for differences in camera distance and player size, we normalized the detected
          skeletons relative to shoulder width.<br />
          We then collected joint angles and relative positions.
        </p>
        <div class="birdie-study__pose">
          <figure>
            <img
              src={`${base}/build-angles-cd.webp`}
              alt="Green skeleton on a black background with two measured joint angles printed beside the elbow and wrist."
              loading="lazy"
            />
            <figcaption>Angles C &amp; D measurments</figcaption>
          </figure>
          <figure>
            <img
              src={`${base}/build-skeletons.webp`}
              alt="Hundreds of colored skeletons overlaid on a black background, with a dense cluster of angle values printed on the right."
              loading="lazy"
            />
            <figcaption>All normalized skeletons together</figcaption>
          </figure>
        </div>
      </div>

      <div class="birdie-study__step">
        <h2>3. Model Developement</h2>
        <p class="birdie-study__step-copy">
          To classify errors in elbow positioning, we implemented logistic regression using joint
          angles calculated from MediaPipe landmarks.<br />
          For Angle D (elbow height), we trained a binary classifier to distinguish between
          acceptable, low, and high elbow positions.<br />
          For Angle C (elbow bend), we incorporated a quadratic feature to identify angles that were
          either too small or too large.
        </p>
        <figure class="birdie-study__plot">
          <img
            src={`${base}/build-angle-d-plot.webp`}
            alt="Plot titled Angle D classify elbow too low: red and blue points by angle in degrees, a blue sigmoid curve falling through a dashed cutoff near minus 40 degrees."
            loading="lazy"
          />
          <figcaption>
            Logistic regression decision boundary for detecting low elbow positioning. Cutoff is
            approxiamately -39.9 degrees.
          </figcaption>
        </figure>
        <figure class="birdie-study__plot">
          <img
            src={`${base}/build-quadratic-plot.webp`}
            alt="Plot titled Quadratic Sigmoid Decision Boundary: a green curve that is high below 38 degrees, low between 38 and 98 degrees, and high above 98 degrees, with two dashed boundary lines."
            loading="lazy"
          />
          <figcaption>
            Quadratic logistic regression for identifying excessively small or large elbow angles.
            Between 38.0 and 98.1 degrees is considered acceptable.
          </figcaption>
        </figure>
        <p class="birdie-study__step-copy birdie-study__step-copy--cnn">
          While logistic regression allowed us to classify specific errors using numerical
          joint-angle measurements, identifying whether the racket arm was open or closed proved to
          be more challenging.<br />
          We therefore developed a convolutional neural network (CNN) in PyTorch to learn visual
          patterns directly from images.
        </p>
        <figure class="birdie-study__cnn">
          <img
            src={`${base}/build-cnn.webp`}
            alt="Diagram of the CNN: a 3 by 224 by 224 input image passes through three convolution, ReLU and pooling blocks, then flatten, a 256-unit fully connected layer and a sigmoid, giving a probability between 0 and 1 that the arm is opened."
            loading="lazy"
          />
          <figcaption>
            Three convolutional blocks extract visual features from 224 x 224 RGB images, followed by
            fully connected layers that predicted whether the racket arm is open or closed.
          </figcaption>
        </figure>
      </div>
    </section>

    <section
      class="birdie-study__panel birdie-study__panel--testing"
      id="birdie-panel-testing"
      role="tabpanel"
      aria-labelledby="birdie-tab-testing"
      data-panel="testing"
      hidden
    >
      <p class="birdie-study__empty">testing notes coming soon.</p>
    </section>

    <section
      class="birdie-study__panel birdie-study__panel--outcome"
      id="birdie-panel-outcome"
      role="tabpanel"
      aria-labelledby="birdie-tab-outcome"
      data-panel="outcome"
      hidden
    >
      {
        data.youtubeId ? (
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${data.youtubeId}`}
            title="BIRDIE badminton form-analysis demonstration"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        ) : (
          <p class="birdie-study__empty">prototype demo coming soon.</p>
        )
      }
    </section>
  </div>
</article>

<script>
  const study = document.querySelector<HTMLElement>('[data-birdie-study]');

  if (study) {
    const tabs = Array.from(study.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(study.querySelectorAll<HTMLElement>('[data-panel]'));

    const select = (id: string, moveFocus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
      history.replaceState(null, '', id === 'overview' ? location.pathname : `#${id}`);
      window.scrollTo(0, 0);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.tab ?? 'overview'));
      tab.addEventListener('keydown', (event) => {
        const offset = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!offset) return;
        event.preventDefault();
        const next = tabs[(index + offset + tabs.length) % tabs.length];
        select(next.dataset.tab ?? 'overview', true);
      });
    });

    const initial = location.hash.slice(1);
    if (tabs.some((tab) => tab.dataset.tab === initial)) select(initial);
  }
</script>
