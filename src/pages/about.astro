---
import BaseLayout from '../layouts/BaseLayout.astro';
import portraitPhoto from '../../photography/about1.jpg';
import flowerPhoto from '../../photography/about2.jpg';
import detailPhoto from '../../photography/about3.jpg';

// Replace this with the full URL for your LinkedIn profile.
const linkedInUrl = 'https://www.linkedin.com/in/angela-ye-bb12281ab/';
---

<BaseLayout
  title="About"
  description="About Angela Yelan, an interdisciplinary maker working across technology and media."
>
  <section class="about-page" aria-labelledby="about-title">
    <div class="about-page__copy">
      <h1 id="about-title">angela ye (叶兰)</h1>

      <p>
        a snoopy fanatic, studying computer science at uc berkeley!<br />
        i'm exploring technology and visual media, interested in all-things computer vision/graphics, 3d animation, & creative-tech.
      </p>

      <div class="about-page__aside">
        <p>the haps for now:</p>
        <ul>
          <li>
            interning at <a href="https://palettelabs.com" target="_blank" rel="noreferrer">Palette (YC S26)</a>
          </li>
          <li>
            creating a documentary for <a href="https://hackberkeley.org" target="_blank" rel="noreferrer">hackathons @ berkeley</a>
          </li>
          <li>rewatching La La Land</li>
          <li>eating! (my beli @angelayelan)</li>
        </ul>
      </div>

      <p class="about-page__links">
        say hello at <a href="mailto:angelaye@berkeley.edu">angelaye@berkeley.edu</a> or via
        <a href={linkedInUrl} target="_blank" rel="noreferrer">linkedin</a>.
      </p>
    </div>

    <div class="about-page__photos">
      <p class="about-page__photos-label">click us!</p>

      <div class="about-page__photos-grid">
        <figure class="about-page__photo about-page__photo--portrait about-page__photo--clickable">
          <img
            src={portraitPhoto.src}
            alt="Angela standing outside in warm evening sunlight"
          />
        </figure>

        <div class="about-page__photo-stack">
          <figure class="about-page__photo about-page__photo--clickable">
            <img
              src={flowerPhoto.src}
              alt="A yellow flower photographed through a soft, dreamy lens"
              loading="lazy"
            />
          </figure>
          <figure class="about-page__photo about-page__photo--clickable">
            <img
              src={detailPhoto.src}
              alt="Hands holding handmade yellow flowers in evening light"
              loading="lazy"
            />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('.about-page__photo--clickable').forEach((photo) => {
      photo.addEventListener('click', () => {
        photo.classList.toggle('is-color');
      });
    });
  </script>
</BaseLayout>
