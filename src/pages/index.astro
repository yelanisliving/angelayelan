---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCollage from '../components/HeroCollage.astro';
import { getCollection } from 'astro:content';
import sortingHatCover from '../../photography/one.png';
import colorGradingCover from '../../photography/two.png';
import birdieCover from '../../photography/three.png';

const tones = ['dark', 'warm', 'blue'];
const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const getProjectSlug = (id: string) => id.replace(/\.md$/, '');
const projectImageOverrides: Record<string, { src: string; alt: string }> = {
  'technical-project-01': {
    src: sortingHatCover.src,
    alt: 'Handmade voice-interactive Hogwarts Sorting Hat on a dark background',
  },
  'technical-project-02': {
    src: colorGradingCover.src,
    alt: 'Poster for the cinematic color-grading research project',
  },
  'technical-project-03': {
    src: birdieCover.src,
    alt: 'BIRDIE badminton form-analysis logo',
  },
};
---

<BaseLayout>
  <section class="hero" aria-labelledby="home-title">
    <HeroCollage />
    <a class="scroll-cue" href="#projects">
      Explore
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <section class="home-section home-projects" id="projects" aria-label="Technical projects">
    <div class="technical-project-grid">
      {
        projects.map((project, index) => (
          <a
            class={`technical-project-card technical-project-card--${tones[index % tones.length]} ${getProjectSlug(project.id) === 'technical-project-03' ? 'technical-project-card--centered' : ''}`}
            href={`/passion-projects/${getProjectSlug(project.id)}`}
          >
            <div class="technical-project-card__media">
              {projectImageOverrides[getProjectSlug(project.id)] || project.data.image ? (
                <img
                  src={projectImageOverrides[getProjectSlug(project.id)]?.src ?? project.data.image}
                  alt={projectImageOverrides[getProjectSlug(project.id)]?.alt ?? project.data.imageAlt ?? ''}
                  loading="lazy"
                />
              ) : (
                <span>Project image {String(index + 1).padStart(2, '0')}</span>
              )}
            </div>
            <div class="technical-project-card__content">
              <p class="technical-project-card__meta">
                {project.data.date.toLocaleDateString('en-US', {
                  month: 'long',
                  year: 'numeric',
                  timeZone: 'UTC',
                })}
              </p>
              <h2>{project.data.title}</h2>
              <p class="technical-project-card__description">{project.data.description}</p>
            </div>
          </a>
        ))
      }

    </div>
  </section>
</BaseLayout>
