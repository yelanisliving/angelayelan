---
import BaseLayout from '../layouts/BaseLayout.astro';
import portraitPhoto from '../../photography/about1.jpg';
import flowerPhoto from '../../photography/about2.jpg';
import detailPhoto from '../../photography/about3.jpg';

// Replace this with the full URL for your LinkedIn profile.
const linkedInUrl = 'https://www.linkedin.com/in/angela-ye-bb12281ab/';
---

<BaseLayout
  title="About"
  description="About Angela Yelan, an interdisciplinary maker working across technology and media."
>
  <section class="about-page" aria-labelledby="about-title">
    <div class="about-page__copy">
      <p class="eyebrow">About</p>
      <h1 id="about-title">Hi! I’m Angela :)</h1>

      <p>
        A snoopy fanatic who's currently exploring the space between technology and visual media, & studying computer science
        at UC Berkeley!
      </p>

      <div class="about-page__aside">
        <p>Outside of school, I’m usually:</p>
        <ul>
          <li>Playing badminton</li>
          <li>Practicing cinematography</li>
          <li>Looking for new movies to watch (or rewatching La La Land)</li>
          <li>EATING</li>
        </ul>
      </div>

      <p class="about-page__links">
        Explore my <a href="/#projects">projects and involvements</a> or watch my
        <a href="/exhibit">exhibit</a>.
      </p>

      <p class="about-page__links">
        Say hello at <a href="mailto:angelaye@berkeley.edu">angelaye@berkeley.edu</a> or via
        <a href={linkedInUrl} target="_blank" rel="noreferrer">LinkedIn</a>.
      </p>
    </div>

    <figure class="about-page__photo about-page__photo--portrait">
      <img
        src={portraitPhoto.src}
        alt="Angela standing outside in warm evening sunlight"
      />
    </figure>

    <div class="about-page__photo-stack">
      <figure class="about-page__photo">
        <img
          src={flowerPhoto.src}
          alt="A yellow flower photographed through a soft, dreamy lens"
          loading="lazy"
        />
      </figure>
      <figure class="about-page__photo">
        <img
          src={detailPhoto.src}
          alt="Hands holding handmade yellow flowers in evening light"
          loading="lazy"
        />
      </figure>
    </div>
  </section>
</BaseLayout>
