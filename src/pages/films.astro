---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getYouTubeId, videos } from '../data/videos';

const preparedVideos = videos.map((video) => ({
  ...video,
  embedId: getYouTubeId(video.youtubeId),
}));

const getVideoPreview = (embedId: string) => `
  <style>
    * { box-sizing: border-box; }
    html, body, a { width: 100%; height: 100%; margin: 0; }
    body { overflow: hidden; background: #202022; }
    a { position: relative; display: grid; place-items: center; }
    img { width: 100%; height: 100%; object-fit: cover; }
    span {
      position: absolute;
      display: grid;
      width: 4.5rem;
      aspect-ratio: 1.45;
      place-items: center;
      border-radius: 1rem;
      color: white;
      background: #ff0033;
      font: 1.8rem/1 sans-serif;
      padding-left: 0.18rem;
    }
  </style>
  <a href="https://www.youtube-nocookie.com/embed/${embedId}?autoplay=1" aria-label="Play video">
    <img src="https://i.ytimg.com/vi/${embedId}/maxresdefault.jpg" alt="" />
    <span aria-hidden="true">▶</span>
  </a>
`;
---

<BaseLayout
  title="Films"
  description="The complete moving-image archive by Angela Yelan."
>
  <header class="media-page__intro archive-page__intro" aria-labelledby="films-page-title">
    <p class="eyebrow">Complete archive</p>
    <h1 id="films-page-title">Videos</h1>
  </header>

  <section class="video-archive" aria-label="Complete video archive">
    {
      preparedVideos.map((video, index) => (
        <article class="media-entry" id={`video-${String(index + 1).padStart(2, '0')}`}>
          <p>{video.note}</p>
          {!video.embedId ? (
            <div class="video-slot" aria-label={`${video.title} embed space`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
          ) : (
            <iframe
              class="video-slot"
              src={`https://www.youtube-nocookie.com/embed/${video.embedId}`}
              srcdoc={getVideoPreview(video.embedId)}
              title={video.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          )}
        </article>
      ))
    }
  </section>

</BaseLayout>
