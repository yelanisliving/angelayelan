---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Project template"
  description="A project case-study template for Angela Yelan's portfolio."
>
  <article class="case-study">
    <header class="case-study__header">
      <p class="eyebrow">Passion project · Template</p>
      <h1>Project title<br />to come.</h1>
      <p class="lede">
        This page is ready for the story, visuals, and process behind the first project.
      </p>
    </header>

    <div class="case-study__canvas" aria-label="Placeholder for a project hero image">
      <span>Project image / video</span>
    </div>

    <div class="case-study__details">
      <section>
        <p class="eyebrow">Overview</p>
        <p>Add the project’s purpose, context, and central idea here.</p>
      </section>
      <section>
        <p class="eyebrow">Process</p>
        <p>Add research, explorations, decisions, and works in progress here.</p>
      </section>
      <section>
        <p class="eyebrow">Outcome</p>
        <p>Add the final result, reflection, and next steps here.</p>
      </section>
    </div>

    <a class="text-link" href="/passion-projects">← Back to passion projects</a>
  </article>
</BaseLayout>
