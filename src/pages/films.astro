---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getYouTubeId, videos } from '../data/videos';

const preparedVideos = videos.map((video) => ({
  ...video,
  embedId: getYouTubeId(video.youtubeId),
}));

// The page opens on the newest video.
const startIndex = preparedVideos.length - 1;
const firstVideo = preparedVideos[startIndex];
const clientVideos = preparedVideos.map(({ title, note, embedId }) => ({
  title,
  note,
  embedId,
}));

const getVideoPreview = (embedId: string) => `
  <style>
    * { box-sizing: border-box; }
    html, body, a { width: 100%; height: 100%; margin: 0; }
    body { overflow: hidden; background: #202022; }
    a { position: relative; display: grid; place-items: center; }
    img { width: 100%; height: 100%; object-fit: cover; }
    span {
      position: absolute;
      display: grid;
      width: 4.5rem;
      aspect-ratio: 1.45;
      place-items: center;
      border-radius: 1rem;
      color: white;
      background: #ff0033;
      font: 1.8rem/1 sans-serif;
      padding-left: 0.18rem;
    }
  </style>
  <a href="https://www.youtube-nocookie.com/embed/${embedId}?autoplay=1" aria-label="Play video">
    <img
      src="https://i.ytimg.com/vi/${embedId}/maxresdefault.jpg"
      onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/${embedId}/hqdefault.jpg'"
      alt=""
    />
    <span aria-hidden="true">▶</span>
  </a>
`;
---

<BaseLayout
  title="Films"
  description="The complete moving-image archive by Angela Yelan."
>
  <section class="cinema-page" aria-labelledby="films-page-title" data-cinema-carousel>
    <header class="cinema-page__masthead">
      <a class="cinema-page__back" href="/exhibit">
        <span aria-hidden="true">←</span> back
      </a>
      <h1 id="films-page-title">videos</h1>
    </header>

    <figure class="cinema-player">
      <div class="cinema-player__stage">
        <img
          class="cinema-player__illustration"
          src="/images/videos/cinema-screen-watercolor-v2.webp"
          alt="A watercolor cinema screen with a small audience"
        />
        <iframe
          class="cinema-player__video"
          src={`https://www.youtube-nocookie.com/embed/${firstVideo.embedId}`}
          srcdoc={firstVideo.embedId ? getVideoPreview(firstVideo.embedId) : undefined}
          title={firstVideo.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          data-cinema-video
        />
      </div>

      <div class="cinema-controls" aria-label="Video controls">
        <button class="cinema-control cinema-control--previous" type="button" aria-label="Previous video" data-cinema-previous></button>
        <div class="cinema-description" id="cinema-description" aria-live="polite">
          <p data-cinema-note>{firstVideo.note}</p>
        </div>
        <button class="cinema-control cinema-control--next" type="button" aria-label="Next video" data-cinema-next></button>
      </div>

    </figure>
  </section>

</BaseLayout>

<script is:inline define:vars={{ clientVideos, startIndex }}>
  const carousel = document.querySelector('[data-cinema-carousel]');

  if (carousel) {
    const frame = carousel.querySelector('[data-cinema-video]');
    const previous = carousel.querySelector('[data-cinema-previous]');
    const next = carousel.querySelector('[data-cinema-next]');
    const note = carousel.querySelector('[data-cinema-note]');
    let activeIndex = startIndex;

    const preview = (embedId) => `
      <style>
        * { box-sizing: border-box; }
        html, body, a { width: 100%; height: 100%; margin: 0; }
        body { overflow: hidden; background: #202022; }
        a { position: relative; display: grid; place-items: center; }
        img { width: 100%; height: 100%; object-fit: cover; }
        span { position: absolute; display: grid; width: 4.5rem; aspect-ratio: 1.45;
          place-items: center; border-radius: 1rem; color: white; background: #ff0033;
          font: 1.8rem/1 sans-serif; padding-left: 0.18rem; }
      </style>
      <a href="https://www.youtube-nocookie.com/embed/${embedId}?autoplay=1" aria-label="Play video">
        <img src="https://i.ytimg.com/vi/${embedId}/maxresdefault.jpg"
          onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/${embedId}/hqdefault.jpg'" alt="" />
        <span aria-hidden="true">▶</span>
      </a>`;

    const showVideo = (index) => {
      activeIndex = (index + clientVideos.length) % clientVideos.length;
      const video = clientVideos[activeIndex];

      if (frame instanceof HTMLIFrameElement && video.embedId) {
        frame.title = video.title;
        frame.src = `https://www.youtube-nocookie.com/embed/${video.embedId}`;
        frame.srcdoc = preview(video.embedId);
      }

      note.textContent = video.note;
    };

    // "Reel swap": the frame pulls out of focus like a projectionist
    // changing film, then racks back into focus on the new title.
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const REEL_SHIFT = 22;
    const REEL_DURATION = 240;
    let isSwapping = false;

    const swapTo = (index, direction) => {
      if (isSwapping) return;

      if (prefersReducedMotion || typeof frame.animate !== 'function') {
        showVideo(index);
        return;
      }

      isSwapping = true;
      const exitX = direction === 'next' ? -REEL_SHIFT : REEL_SHIFT;
      const enterX = direction === 'next' ? REEL_SHIFT : -REEL_SHIFT;

      const pullOut = frame.animate(
        [
          { transform: 'translateX(-50%) translateX(0px)', filter: 'blur(0px)', opacity: 1 },
          { transform: `translateX(-50%) translateX(${exitX}px)`, filter: 'blur(7px)', opacity: 0 },
        ],
        { duration: REEL_DURATION, easing: 'ease-in' },
      );

      pullOut.onfinish = () => {
        showVideo(index);

        const rackIn = frame.animate(
          [
            { transform: `translateX(-50%) translateX(${enterX}px)`, filter: 'blur(7px)', opacity: 0 },
            { transform: 'translateX(-50%) translateX(0px)', filter: 'blur(0px)', opacity: 1 },
          ],
          { duration: REEL_DURATION, easing: 'ease-out' },
        );

        rackIn.onfinish = () => {
          isSwapping = false;
        };
      };
    };

    previous?.addEventListener('click', () => swapTo(activeIndex - 1, 'previous'));
    next?.addEventListener('click', () => swapTo(activeIndex + 1, 'next'));

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        swapTo(activeIndex - 1, 'previous');
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        swapTo(activeIndex + 1, 'next');
      }
    });
  }
</script>
