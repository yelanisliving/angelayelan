---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('blog', ({ data }) => !data.draft);

  return essays.map((essay) => ({
    params: { slug: essay.id.replace(/\.md$/, '') },
    props: { essay },
  }));
}

interface Props {
  essay: CollectionEntry<'blog'>;
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const published =
  essay.data.dateLabel ??
  essay.data.publishedAt
    .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    .toLowerCase();
---

<BaseLayout title={essay.data.title} description={essay.data.description ?? 'Writing by Angela Yelan.'}>
  <article class="essay">
    <a class="cinema-page__back" href="/writing">
      <span aria-hidden="true">←</span> back
    </a>
    <header class="essay__header">
      <h1>{essay.data.title}</h1>
      {essay.data.description && <p class="essay__bio">{essay.data.description}</p>}
      <p class="essay__date">
        {published}
        {
          essay.data.originalUrl && (
            <>
              {' | '}
              <a href={essay.data.originalUrl} target="_blank" rel="noreferrer">read original</a>
            </>
          )
        }
      </p>
    </header>
    <div class="essay__body">
      <Content />
    </div>
  </article>
</BaseLayout>
